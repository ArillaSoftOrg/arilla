{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web", "framework": "nextjs" },
    "link": { "root": "services/ingest", "framework": "python", "entrypoint": "pyproject.toml" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }],
  "crons": [
    { "path": "/api/cron/generate-discovery-slots", "schedule": "0 0 * * *" },
    { "path": "/api/cron/cleanup-auth", "schedule": "30 3 * * *" },
    { "path": "/api/cron/interpret-queries", "schedule": "30 0 * * *" },
    { "path": "/api/cron/refresh-product-aggregates", "schedule": "45 23 * * *" }
  ]
}
