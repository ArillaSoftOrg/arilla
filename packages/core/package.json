{
  "name": "@arilla/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin-session": "./src/admin/session-policy.ts",
    "./cost-truth": "./src/admin/cost-truth.ts",
    "./auth-redirect": "./src/auth/safe-redirect.ts",
    "./anonymous-session": "./src/auth/anonymous-session.ts",
    "./product-access": "./src/access/product-access.ts",
    "./quota-policy": "./src/quota/policy.ts",
    "./clarification": "./src/clarification/index.ts",
    "./cookie-consent": "./src/consent/cookie-consent.ts",
    "./ga4-measurement": "./src/analytics-ga4/measurement.ts",
    "./link-input": "./src/discovery/link-search-input.ts",
    "./legal-identity": "./src/config/legal-identity.ts",
    "./media-url": "./src/storage/media-url.ts",
    "./media-keys": "./src/storage/media-keys.ts",
    "./storage": "./src/storage/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "curated:load": "node scripts/load-curated-pool.ts",
    "media:import-blog": "node scripts/import-blog-images.ts",
    "eval:intent": "node --experimental-transform-types --no-warnings scripts/eval-intent.ts",
    "eval:record-matching": "node --experimental-transform-types --no-warnings scripts/eval-record-matching.ts",
    "eval:search-compare": "node scripts/search-eval-compare.ts",
    "gemini:smoke": "node --experimental-transform-types --no-warnings scripts/gemini-smoke.ts"
  },
  "dependencies": {
    "@arilla/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.1146.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.23.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
