# Bu dosya yalnizca anahtar ADLARINI icerir. Gercek degerler asla depoya girmez.

# --- Uygulama ---
APP_NAME=Arilla
# Sitenin kok adresi: protokol + alan adi (+ port), YOL ve sondaki slash YOK.
# Uretimde: APP_URL=https://GERCEK-ALAN-ADI  (gercek alan adi henuz belli degil)
# Canonical, metadataBase, robots.txt, sitemap'ler, giris ve alarm e-postasi
# linkleri buradan uretilir. packages/core/src/config/app-url.ts sondaki
# slash'i kirpar; protokolsuz veya yol iceren deger hata firlatir.
# robots.txt ve sitemap.xml BUILD aninda uretilir - deger build ortaminda da
# tanimli olmali, yoksa yanlis/eksik alan adi statik dosyaya gomulur.
APP_URL=http://localhost:3000
# Marka adi ve alan adi degisecek. Koda gomulmez, buradan okunur.

# --- Veritabani ---
# Uygulama rolu. superuser DEGILDIR: price_point ve variant_stock_event
# uzerinde yalnizca SELECT ve INSERT yetkisi vardir. Bkz. migrations/0010.
DATABASE_URL=postgresql://arilla_app:@localhost:5432/arilla
# Sahip rol. Yalnizca migration ve bakim betikleri kullanir, uygulama asla.
DATABASE_URL_OWNER=postgresql://arilla:arilla_local@localhost:5432/arilla
# arilla_app parolasi. pnpm db:bootstrap-role bunu role yazar.
APP_DB_PASSWORD=

# --- Redis ---
# Uretimde ZORUNLU. Web (ioredis): /ara arama duvari sayaci, giris orani
# siniri, gorsel arama gunluk limiti, link cozumleme kuyrugu (LPUSH).
# Python link worker'i ayni kuyrugu ayni REDIS_URL ile okur.
# Bicim: redis://[:PAROLA@]HOST:PORT  veya TLS icin rediss://KULLANICI:PAROLA@HOST:PORT
# (barindirilan saglayicilar - orn. Upstash - genelde rediss:// ister).
# Standart Redis protokolu (TCP) gerekir; yalnizca HTTP/REST sunan bir API
# yetmez. Redis erisilemezse /ara ~10 sn sonra hata sayfasi gosterir.
REDIS_URL=redis://localhost:6379

# --- Obje deposu (S3 uyumlu) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=arilla-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- E-posta ---
# Yerelde mailpit, uretimde Resend veya Postmark.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=
RESEND_API_KEY=

# --- Kimlik dogrulama ---
SESSION_SECRET=
AUTH_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=90

# --- Model saglayici ---
# Yalnizca sunucu tarafinda kullanilir. Istemciye asla gonderilmez.

# Embedding: Jina CLIP v2 — barindirilan cok-kipli API. Metin ve gorsel ayni
# vektor uzayina duser; kendi modelimizi barindirmiyoruz, GPU servisi yok.
# Bkz. docs/decisions/0015-embedding-saglayici.md
JINA_API_KEY=
# embedding.model_version kolonuna yazilan deger. Her satir hangi modelin
# urettigini tasir; model degisimi katalogu cope atmaz.
EMBEDDING_MODEL_VERSION=jina-clip-v2
# Matryoshka kirpma. Sema vector(768) taahhut ediyor.
EMBEDDING_DIMENSIONS=768
# Bin token basina maliyet (TRY milyonda bir). Saglayici hesabi acilana kadar
# 0; api_usage.units token sayisini tuttugu icin maliyet sonradan hesaplanir.
EMBEDDING_COST_MICROS_PER_1K_TOKENS=0

# Uretilmis icerik (generated_content) tarafi — ayri bir karar, henuz acik.
LLM_API_KEY=

# --- Maliyet sinirlari ---
VISUAL_SEARCH_DAILY_LIMIT_PER_USER=20
SESSION_COST_ALERT_MICROS=

# --- Gelistirme ---
# Tohum verisinin gorsel adresleri varsayilan olarak cozulmeyen .example alan
# adlarina gider. Yerel fixture sunucusuna yoneltmek icin:
#   SEED_IMAGE_BASE_URL=http://127.0.0.1:8099
SEED_IMAGE_BASE_URL=

# --- Arama ---
FREE_SEARCHES_BEFORE_LOGIN=3
# Esikler UYDURULMADI: 60 ciftlik regresyon setinden olculdu.
# `python -m resolve --calibrate` yeniden uretir. Bkz. docs/decisions/0017.
MATCH_AUTO_ACCEPT_THRESHOLD=0.84
MATCH_QUEUE_THRESHOLD=0.63

# --- Zamanlanmis isler ---
# Vercel Cron -> /api/cron/trigger-alerts. Bu degeri bilmeyen istek 401 alir.
CRON_SECRET=

# --- Ana sayfa demo icerik (Admitad oncesi) ---
# Admitad/merchant feed baglanana kadar gercek discovery_slot verisi bos
# olabilir; ama proje bu asamada bile production'a vitrin/basvuru amacli
# deploy edilebilir. NODE_ENV'e BAGLI DEGILDIR - development/production
# ayrimi degil, bilinçli bir icerik kararidir. Bu deger secret degildir.
#
# HOMEPAGE_DEMO_CONTENT=true  -> gercek discovery_slot bossa demo urun
#                                izgarasi gosterilir (yalnizca bossa).
# HOMEPAGE_DEMO_CONTENT=false -> demo fallback kapali, gercek katalog
#                                bossa kesif bolumu hic render edilmez.
# Sadece tam olarak "true" degeri acar - bkz.
# apps/web/app/discovery-adapter.ts. Admitad sonrasi temizlik: bu satiri
# false yapmak veya silmek yeterli, kod/DB degisikligi gerekmez.
HOMEPAGE_DEMO_CONTENT=false
