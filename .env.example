# Ortam degiskeni sozlesmesi. Bu dosya yalnizca anahtar ADLARINI ve guvenli
# yerel varsayilanlari (docker/Mailpit) icerir. Gercek degerler asla depoya
# girmez. Kopyala: `cp .env.example .env`. Ayrinti: docs/ops.md "Ortam degiskenleri".
#
# Gruplar:
#   REQUIRED_PRODUCTION  - uretimde (Vercel production) tanimli olmali.
#   OPTIONAL_PRODUCTION  - uretimde ayarlanabilir; bos kalirsa kod varsayilani.
#   DEVELOPMENT_ONLY     - yalnizca yerel/test. Uretimde TANIMLANMAZ.
#   TOOLING_ONLY         - migration/seed betikleri ve CI. Uygulama okumaz.
#   VERCEL_SYSTEM        - Vercel'in kendisi verir; elle AYARLANMAZ.

# =============================================================================
# REQUIRED_PRODUCTION
# =============================================================================

# Sitenin kok adresi: protokol + host (+ port). YOL ve sondaki slash YOK.
# Canonical (metadataBase), robots.txt, sitemap'ler, urun JSON-LD, giris ve
# alarm e-postasi linkleri buradan uretilir (packages/core/src/config/app-url.ts).
# Vercel'de bos birakilirsa VERCEL_PROJECT_PRODUCTION_URL'e (https) duser;
# ozel alan adi baglaninca buraya https://<alan-adi> yazilir.
# Vercel production'da https ve localhost-disi olmak ZORUNDA, yoksa build/istek
# firlatir. robots.txt build aninda uretilir (sitemap.xml istek aninda): deger
# build ortaminda da tanimli olmali. Vercel preview'da APP_URL yoksa giris/alarm
# e-postasi linkleri deploy'un kendi adresine (VERCEL_URL) gider; canonical ise
# production host'unda kalir. Python link worker'i User-Agent'ta kullanir.
APP_URL=http://localhost:3000

# Uygulama rolu (arilla_app, superuser DEGIL; append-only tablolarda yalnizca
# SELECT + INSERT). Vercel'de Supabase TRANSACTION POOLER adresi (port 6543)
# kullanilir - serverless her istekte baglanti acar, dogrudan 5432 tukenir.
# Okuyan: packages/db/src/client.ts, services/ingest/db/connection.py.
DATABASE_URL=postgresql://arilla_app:@localhost:5432/arilla

# Web (ioredis): arama duvari sayaci, giris orani siniri, gorsel arama gunluk
# limiti, link cozumleme kuyrugu. Python link worker'i ayni kuyrugu okur.
# Bicim: redis://[:PAROLA@]HOST:PORT veya TLS icin rediss://KULLANICI:PAROLA@HOST:PORT
# Standart Redis protokolu (TCP) gerekir; yalnizca REST sunan API yetmez.
# Okuyan: packages/core/src/redis/client.ts, services/ingest/collect/link/__main__.py.
REDIS_URL=redis://localhost:6379

# Oturum ve giris token'i imzalama; tanimsizsa hata firlatir.
# Uzun, rastgele bir deger (orn. openssl rand -base64 32).
# Okuyan: packages/core/src/auth/token.ts.
SESSION_SECRET=

# Google OAuth ile giris. Redirect URI Google Cloud Console'da
# `${APP_URL}/giris/google/callback` olarak tanimli olmali.
# Okuyan: apps/web/app/giris/google/*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Giris linki ve alarm e-postalari (packages/core/src/email/transport.ts).
# Yerelde Mailpit (localhost:1025, kimlik dogrulamasiz). SMTP_HOST yerel
# degilse SMTP_USER + SMTP_PASS ZORUNLU (birlikte); aksi halde gonderim
# reddedilir. Kimlik dogrulamali baglantida TLS zorunlu tutulur.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Gonderici adresi. Public iletisim adresi (apps/web/app/site-config.ts) DEGIL.
EMAIL_FROM=

# Gorsel arama embedding'i (Jina CLIP v2). Uretimde bos ise gorsel arama
# EmbeddingUnavailableError ile reddedilir. Bkz. docs/decisions/0015.
# Okuyan: packages/core/src/embedding/client.ts, services/ingest/enrich/client.py.
JINA_API_KEY=

# Cron uclari (/api/cron/*) icin Bearer sir. Tanimsiz/kisa (<16) ise uclar
# her istegi reddeder. Ayni deger GitHub Actions secret'i olarak da girilir
# (asagida TOOLING_ONLY). Okuyan: packages/core/src/cron/cron-auth.ts.
CRON_SECRET=

# =============================================================================
# OPTIONAL_PRODUCTION  (bos birakilirsa parantez icindeki kod varsayilani)
# =============================================================================

# SMTP dogrudan TLS (465) icin "true", STARTTLS icin "false".
# (Bos: port 465 ise true, degilse false.)
SMTP_SECURE=

# Uygulama baglanti havuzu ust siniri (5). Serverless'ta kucuk tutulur.
# Okuyan: packages/db/src/client.ts.
DATABASE_POOL_MAX=

# Giris linki gecerlilik suresi, dakika.
AUTH_TOKEN_TTL_MINUTES=15
# Oturum cerezi suresi, gun.
SESSION_TTL_DAYS=90

# Girissiz serbest arama sayisi (packages/core/src/auth/search-wall.ts).
FREE_SEARCHES_BEFORE_LOGIN=3
# Kullanici basina gunluk gorsel arama limiti.
VISUAL_SEARCH_DAILY_LIMIT_PER_USER=20
# Link aramasi (0031): kullanici/oturum basina gunluk YENI sayfa getirme siniri.
# Onbellekten (ayni link, 24 sa) donen sonuc sayilmaz.
LINK_SEARCH_DAILY_LIMIT_PER_USER=30
# Bin token basina embedding maliyeti (TRY milyonda bir) - api_usage icin.
# Web ve Python ikisi de okur. (0)
EMBEDDING_COST_MICROS_PER_1K_TOKENS=0

# Eslestirme esikleri - YALNIZCA Python (services/ingest/resolve/score.py).
# Uydurulmadi: regresyon setinden olculdu; `python -m resolve --calibrate`
# yeniden uretir. Bkz. docs/decisions/0017. (0.84 / 0.63)
MATCH_AUTO_ACCEPT_THRESHOLD=0.84
MATCH_QUEUE_THRESHOLD=0.63

# Ana sayfa demo icerigi (Admitad oncesi). Tam olarak "true" ise gercek
# discovery_slot bossa demo izgarasi gosterilir; aksi halde kesif bolumu
# render edilmez. Secret degil, bilincli icerik karari.
# Okuyan: apps/web/app/discovery-adapter.ts.
HOMEPAGE_DEMO_CONTENT=false

# Merchant feed kaynaklarinin kimlik bilgileri kaynak yapilandirmasindaki
# `auth.env` alaninda ADI verilen degiskenden okunur
# (services/ingest/collect/sources/rest_api.py). Ad kaynaga ozgudur.

# =============================================================================
# DEVELOPMENT_ONLY  (uretimde tanimlanmaz)
# =============================================================================

# "true": Jina anahtari olmadan deterministik sahte embedding istemcisi.
# NODE_ENV=production iken REDDEDILIR. Okuyan: packages/core/src/embedding/client.ts.
EMBEDDING_FAKE_CLIENT=

# =============================================================================
# TOOLING_ONLY  (uygulama calisirken okunmaz)
# =============================================================================

# Sahip rol: yalnizca migration/bakim betikleri ve DB entegrasyon testleri.
# Vercel'de TANIMLANMAZ - migration yerelde veya CI'da calisir.
# Okuyan: packages/db/scripts/*, packages/db/drizzle.config.ts, packages/core/src/test-db.ts.
DATABASE_URL_OWNER=postgresql://arilla:arilla_local@localhost:5432/arilla
# arilla_app parolasi; `pnpm db:bootstrap-role` role yazar.
APP_DB_PASSWORD=
# Tohum gorsel adresleri icin yerel fixture sunucusu (packages/db/scripts/seed.ts).
#   SEED_IMAGE_BASE_URL=http://127.0.0.1:8099
SEED_IMAGE_BASE_URL=

# GitHub Actions secret'lari (.github/workflows/trigger-alerts-cron.yml) -
# .env'e degil, depo ayarlarindaki Actions secrets'a girilir:
#   ALERT_CRON_URL  -> https://<site>/api/cron/trigger-alerts
#   CRON_SECRET     -> Vercel'deki CRON_SECRET ile ayni deger

# Vercel proje ayari (uygulama okumaz): package.json `packageManager`
# (pnpm 11) kullanilsin diye Vercel ortam degiskeni olarak:
#   ENABLE_EXPERIMENTAL_COREPACK=1

# =============================================================================
# VERCEL_SYSTEM  (Vercel otomatik saglar - elle AYARLAMA, burada yalnizca belge)
# =============================================================================
#   VERCEL_ENV                     production | preview | development.
#                                  "production" iken APP_URL https + localhost-disi zorunlu.
#   VERCEL_PROJECT_PRODUCTION_URL  Protokolsuz production host'u; APP_URL bossa
#                                  https://<bu> kullanilir.
# NODE_ENV'i Next.js kendisi ayarlar; elle ayarlanmaz.

# =============================================================================
# Kaldirilan anahtarlar (hicbir kod okumuyordu): APP_NAME, S3_ENDPOINT,
# S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, RESEND_API_KEY
# (e-posta SMTP ile gider), LLM_API_KEY, SESSION_COST_ALERT_MICROS,
# EMBEDDING_MODEL_VERSION, EMBEDDING_DIMENSIONS (ikisi koddaki sabitler).
# Kod bunlari okumaya basladiginda ayni degisiklikte buraya geri eklenir.
# =============================================================================
