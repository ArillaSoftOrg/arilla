# Bu dosya yalnizca anahtar ADLARINI icerir. Gercek degerler asla depoya girmez.

# --- Uygulama ---
APP_NAME=Arilla
APP_URL=http://localhost:3000
# Marka adi ve alan adi degisecek. Koda gomulmez, buradan okunur.

# --- Veritabani ---
# Uygulama rolu. superuser DEGILDIR: price_point ve variant_stock_event
# uzerinde yalnizca SELECT ve INSERT yetkisi vardir. Bkz. migrations/0010.
DATABASE_URL=postgresql://arilla_app:@localhost:5432/arilla
# Sahip rol. Yalnizca migration ve bakim betikleri kullanir, uygulama asla.
DATABASE_URL_OWNER=postgresql://arilla:arilla_local@localhost:5432/arilla
# arilla_app parolasi. pnpm db:bootstrap-role bunu role yazar.
APP_DB_PASSWORD=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Obje deposu (S3 uyumlu) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=arilla-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- E-posta ---
# Yerelde mailpit, uretimde Resend veya Postmark.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=
RESEND_API_KEY=

# --- Kimlik dogrulama ---
SESSION_SECRET=
AUTH_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=90

# --- Model saglayici ---
# Yalnizca sunucu tarafinda kullanilir. Istemciye asla gonderilmez.
EMBEDDING_MODEL_VERSION=
EMBEDDING_API_KEY=
LLM_API_KEY=

# --- Maliyet sinirlari ---
VISUAL_SEARCH_DAILY_LIMIT_PER_USER=20
SESSION_COST_ALERT_MICROS=

# --- Arama ---
FREE_SEARCHES_BEFORE_LOGIN=3
MATCH_AUTO_ACCEPT_THRESHOLD=0.92
MATCH_QUEUE_THRESHOLD=0.70
