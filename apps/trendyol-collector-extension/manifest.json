{
  "manifest_version": 3,
  "name": "ManiCepte Trendyol toplayici (yonetici)",
  "version": "0.1.0",
  "description": "Yoneticinin actigi Trendyol urun/liste sayfasindaki veriyi okur ve ManiCepte yonetim sayfasina aktarir. Ag istegi atmaz (karar 0118).",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.trendyol.com/*"],
      "js": ["capture.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://manicepte.com/yonetim/katalog/toplama/trendyol*",
        "https://www.manicepte.com/yonetim/katalog/toplama/trendyol*",
        "http://localhost:3000/yonetim/katalog/toplama/trendyol*"
      ],
      "js": ["relay.js"],
      "run_at": "document_idle"
    }
  ]
}
