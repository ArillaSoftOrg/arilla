# Uretim link worker'i ortam degiskenleri (docs/ops.md "Link worker").
# Kopyala: cp infra/.env.worker.example infra/.env.worker  (dosya depoya girmez)
# Gercek deger BURAYA yazilmaz; yalnizca ad ve bicim ornegi.

# Postgres (uygulama rolu, migration yetkisi YOK). Gerekli.
DATABASE_URL=postgresql://arilla_app:CHANGE_ME@db.example.com:5432/postgres

# Web'in kuyruk Redis'i. Gerekli; uretimde rediss:// (TLS) ZORUNLU, aksi halde
# worker baslamaz. Web ile ayni veritabani/Redis olmali.
REDIS_URL=rediss://default:CHANGE_ME@redis.example.com:6379

# Gorsel embedding saglayicisi. Bos ise worker metinle calisir (image_status=unavailable).
JINA_API_KEY=

# Maliyet olcumu (api_usage.cost_micros): 1000 token basina mikro-TRY.
EMBEDDING_COST_MICROS_PER_1K_TOKENS=0

# Istege bagli: dakikadaki Jina token tavani (varsayilan 80000, karar 0028).
# JINA_TOKENS_PER_MINUTE=

# Istege bagli: saglik denetimi dosyasi (varsayilan /tmp/link-worker.heartbeat).
# WORKER_HEARTBEAT_FILE=/tmp/link-worker.heartbeat
