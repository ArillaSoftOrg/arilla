[Unit]
Description=Arilla izole geri yukleme provasi (karar 0110, 0183)
Requires=docker.service
After=docker.service
OnFailure=arilla-alert@%n.service

[Service]
Type=oneshot
# --auto: disk TAM provaya guvenle yetiyorsa TAM, yetmiyorsa KISMI (tam kanit degil); karar 0183.
ExecStart=/opt/arilla/vps/bin/pg-restore-test --auto
TimeoutStartSec=8h
Nice=15
IOSchedulingClass=idle
