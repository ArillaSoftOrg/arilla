[Unit]
Description=Arilla price_point bolum kontrolu: default bos mu + ufuk (salt okunur)
Requires=docker.service
After=docker.service
OnFailure=arilla-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/arilla
# Oturum READ ONLY: sahip kimligiyle bile yazmaz (karar 0188). Cikis 1 (KRITIK): default dolu ya da
# bu ayin/gelecek ayin bolumu yok -> unit failed + alarm. Ufuk politikanin (bu ay + 3) gerisinde
# ama bir aylik pay varsa yalniz UYARI (cikis 0, gunlukte). Runbook: docs/ops.md.
ExecStart=/usr/bin/docker compose --env-file /opt/arilla/compose.env -f /opt/arilla/compose.prod.yml run --rm migrate node scripts/partitions.ts --check
TimeoutStartSec=120
