[Unit]
Description=Arilla TCMB doviz kuru (karar 0113)
Requires=docker.service
After=docker.service
OnFailure=arilla-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/arilla
ExecStart=/usr/bin/docker compose --env-file /opt/arilla/compose.env -f /opt/arilla/compose.prod.yml --profile feeds run --rm -e JOB_RUN_TRIGGER=cron feeds python -m pricing fx
TimeoutStartSec=10min
