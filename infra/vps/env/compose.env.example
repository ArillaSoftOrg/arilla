# Compose DEGISKENLERI (sir DEGIL). Kullanim:
#   docker compose --env-file /opt/arilla/compose.env -f /opt/arilla/compose.prod.yml ...
# init-secrets.sh bunu da yazar.
ARILLA_SITE_ADDRESS=@@DOMAIN@@
ARILLA_ENV_DIR=@@ENV_DIR@@
# Surum: `infra/vps/bin/release.py apply release-manifest.json` bunlari yazar/gunceller
# (ARILLA_TAG=sha-<40 hane>, ARILLA_{WEB,MIGRATE,INGEST,CRON}_DIGEST=sha256:..., *_IMAGE).
# Elle degistirilmez; geri alma: `release.py rollback`.
ARILLA_TAG=@@TAG@@
