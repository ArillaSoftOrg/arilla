# Compose DEGISKENLERI (sir DEGIL). Kullanim:
#   docker compose --env-file /opt/arilla/compose.env -f /opt/arilla/compose.prod.yml ...
# init-secrets.sh bunu da yazar.
ARILLA_SITE_ADDRESS=@@DOMAIN@@
ARILLA_ENV_DIR=@@ENV_DIR@@
# Dagitim betigi (faz 6) her surumde ARILLA_TAG'i imaj sha'sina cevirir.
ARILLA_TAG=@@TAG@@
# GHCR imaj adlari (faz 3'te kesinlesir):
# ARILLA_WEB_IMAGE=ghcr.io/arillasoftorg/arilla-web
# ARILLA_INGEST_IMAGE=ghcr.io/arillasoftorg/arilla-ingest
# ARILLA_MIGRATE_IMAGE=ghcr.io/arillasoftorg/arilla-migrate
# ARILLA_CRON_IMAGE=ghcr.io/arillasoftorg/arilla-cron
