# web servisi calisma zamani degerleri (infra/compose.prod.yml). Bu dosya SABLONDUR:
# `infra/vps/bin/init-secrets.sh` @@...@@ yer tutucularini uretilmis degerlerle
# doldurur ve /opt/arilla/env/web.env olarak yazar. Gercek dosya depoya GIRMEZ.
# DEPLOY_ENV, REDIS_PLAINTEXT_HOSTS ve DATABASE_POOL_MAX compose'ta sabittir.
# Anlamlar ve okuyan kod: .env.example. Bos birakilan anahtar o ozelligi kapatir.

# --- Otomatik doldurulur ---------------------------------------------------------
APP_URL=@@APP_URL@@
DATABASE_URL=postgresql://arilla_app:@@APP_DB_PASSWORD@@@postgres:5432/arilla
REDIS_URL=redis://:@@REDIS_PASSWORD@@@redis:6379
SESSION_SECRET=@@SESSION_SECRET@@
CRON_SECRET=@@CRON_SECRET@@
LINK_QUEUE_BACKEND=redis

# --- Lansman kapisi: bos = KAPALI (landing); acmak icin "open" ----------------------
PRODUCT_ACCESS=

# --- Elle doldurulur (bos = ozellik kapali) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SMS_PROVIDER=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
PHONE_ALLOWED_COUNTRY_CODES=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=
JINA_API_KEY=
EMBEDDING_COST_MICROS_PER_1K_TOKENS=0
GEMINI_API_KEY=
LLM_COST_TRY_PER_USD=
R2_PUBLIC_BASE_URL=
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# --- Ozellik bayraklari: hukuki onay olmadan ACILMAZ (docs/ops.md) --------------------
GEMINI_REALTIME_ENABLED=
WEB_SEARCH_ENABLED=
WEB_SEARCH_LEGAL_APPROVED=
CHAT_DISCOVERY_ENABLED=
CHAT_IMAGE_ENABLED=
MARKETING_EMAIL_ENABLED=
MARKETING_EMAIL_FROM=
MARKETING_EMAIL_REPLY_TO=
HOMEPAGE_DEMO_CONTENT=
