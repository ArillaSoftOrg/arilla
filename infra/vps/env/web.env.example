# web servisi calisma zamani degerleri (infra/compose.prod.yml). Bu dosya SABLONDUR:
# `infra/vps/bin/init-secrets.sh` @@...@@ yer tutucularini uretilmis degerlerle
# doldurur ve /opt/arilla/env/web.env olarak yazar. Gercek dosya depoya GIRMEZ.
# DEPLOY_ENV, REDIS_PLAINTEXT_HOSTS ve DATABASE_POOL_MAX compose'ta sabittir.
# Anlamlar ve okuyan kod: .env.example. Bos birakilan anahtar o ozelligi kapatir.

# --- Otomatik doldurulur ---------------------------------------------------------
APP_URL=@@APP_URL@@
DATABASE_URL=postgresql://arilla_app:@@APP_DB_PASSWORD@@@postgres:5432/arilla
REDIS_URL=redis://:@@REDIS_PASSWORD@@@redis:6379
SESSION_SECRET=@@SESSION_SECRET@@
CRON_SECRET=@@CRON_SECRET@@
LINK_QUEUE_BACKEND=redis
# Link kuyrugu Redis'i (karar 0123): worker.env'deki REDIS_URL ile AYNI sunucu olmali.
# Bos birakilirsa web link isini REDIS_URL'deki sunucuya yazar; REDIS_URL baska bir
# yoneticili Redis'e bakiyorsa worker o isi hic gormez (istek 60 sn sonra zaman asimina duser).
LINK_REDIS_URL=redis://:@@REDIS_PASSWORD@@@redis:6379

# --- Lansman kapisi: bos = KAPALI (landing); acmak icin "open" ----------------------
PRODUCT_ACCESS=

# --- Elle doldurulur (bos = ozellik kapali) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SMS_PROVIDER=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
PHONE_ALLOWED_COUNTRY_CODES=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=
EMAIL_REPLY_TO=
JINA_API_KEY=
EMBEDDING_COST_MICROS_PER_1K_TOKENS=0
GEMINI_API_KEY=
LLM_COST_TRY_PER_USD=
R2_PUBLIC_BASE_URL=
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
# Umami (karar 0116). BASE_URL / WEBSITE_ID sir degil (izleyici + CSP, ayni degerler derleme
# degiskeni olarak da verilir: depo degiskenleri UMAMI_BASE_URL, UMAMI_WEBSITE_ID). API_KEY SIRDIR:
# yalniz burada, istemciye ve gunluge girmez. Bos = Umami analitigi kapali.
UMAMI_BASE_URL=
UMAMI_WEBSITE_ID=
UMAMI_TRACKER_SCRIPT_NAME=
UMAMI_API_KEY=

# --- Ozellik bayraklari: hukuki onay olmadan ACILMAZ (docs/ops.md) --------------------
GEMINI_REALTIME_ENABLED=
WEB_SEARCH_ENABLED=
WEB_SEARCH_LEGAL_APPROVED=
CHAT_DISCOVERY_ENABLED=
CHAT_IMAGE_ENABLED=
MARKETING_EMAIL_ENABLED=
MARKETING_EMAIL_FROM=
MARKETING_EMAIL_REPLY_TO=
HOMEPAGE_DEMO_CONTENT=

# --- Katalog kesif defteri (karar 0120) -------------------------------------------------
# Veritabani boyutu tavani (bayt). Asilirsa kesif partileri reddedilir; bos birakilirsa 60 GiB.
CATALOG_DISCOVERY_DB_MAX_BYTES=
