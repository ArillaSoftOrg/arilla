# migrate servisi (gecici `run --rm`): SAHIP kimligi yalnizca burada.
# Betikler yerel olmayan hedefe yazmayi reddeder; compose agindaki host adi
# burada acikca onaylanir (docs/ops.md "Migration job").
DATABASE_URL_OWNER=postgresql://arilla:@@POSTGRES_PASSWORD@@@postgres:5432/arilla
# verify-schema uygulama rolunu sinar.
DATABASE_URL=postgresql://arilla_app:@@APP_DB_PASSWORD@@@postgres:5432/arilla
APP_DB_PASSWORD=@@APP_DB_PASSWORD@@
ARILLA_CONFIRM_REMOTE_DB=postgres
