# worker servisi (Python link worker'i). Sablon: init-secrets.sh doldurur.
# Sahip (owner) kimligi ve migration yetkisi YOK; yalniz arilla_app.
DATABASE_URL=postgresql://arilla_app:@@APP_DB_PASSWORD@@@postgres:5432/arilla
REDIS_URL=redis://:@@REDIS_PASSWORD@@@redis:6379
APP_URL=@@APP_URL@@

# Elle: gorsel embedding. Bos ise worker metinle calisir (image_status=unavailable).
JINA_API_KEY=
EMBEDDING_COST_MICROS_PER_1K_TOKENS=0
