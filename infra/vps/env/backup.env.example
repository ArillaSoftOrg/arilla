# Yedekleme (karar 0110) - ELLE doldurulur, /opt/arilla/env/backup.env (0640 root:deploy).
# Depoya GIRMEZ. pg-backup-configure bu degerlerden pgBackRest yapilandirmasini uretir.
# Adim adim Cloudflare kurulumu: docs/ops.md "Yedekleme ve geri yukleme".

# Cloudflare hesap kimligi (R2 > Overview). Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# Bucket bir yurisdiksiyonla (ornegin AB) olusturulduysa: eu  (endpoint <ACCOUNT_ID>.eu.r2...).
# Varsayilan yurisdiksiyonda BOS birakin.
R2_JURISDICTION=
# YALNIZ yedek icin ayrilmis bucket (medya bucket'i KULLANILMAZ).
R2_BACKUP_BUCKET=
# R2 API token'i: "Object Read & Write", YALNIZ yukaridaki bucket'a kapsamli.
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# Depo sifreleme parolasi (en az 32 karakter). ONCE parola yoneticisine kaydedin, sonra buraya
# yazin: sunucu kaybolursa yedekler YALNIZ bu parolayla acilir.
# Uretmek icin: openssl rand -base64 48
PGBACKREST_REPO_CIPHER_PASS=

# --- Istege bagli (varsayilanlar) ----------------------------------------------------
# Bucket icindeki onek
# PGBACKREST_REPO_PATH=/pgbackrest
# Tutulacak tam yedek sayisi (haftalik tam yedekte ~4 hafta)
# PGBACKREST_RETENTION_FULL=4
# Depoya ulasilamazsa birikecek en fazla WAL (asilinca WAL birakilir, PITR kopar; disk korunur)
# PGBACKREST_ARCHIVE_QUEUE_MAX=4GiB
# archive_timeout (saniye): dusuk trafikte RPO ust siniri
# PGBACKREST_ARCHIVE_TIMEOUT=300
