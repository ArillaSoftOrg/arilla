#!/usr/bin/env bash
# arilla-catalog-auto.service ExecCondition: hat BU SEFER baslayabilir mi? (karar 0163)
#   cikis 0 = basla; cikis 1 = atla (systemd bunu hata saymaz, alarm uretmez).
# Yalniz OKUR: systemctl durumu ve disk. Python tarafi ayrica advisory kilitlerine, yedek
# penceresine ve diske bakar; bu betik gereksiz konteyner baslatmamak icin ilk elemedir.
set -euo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LC_ALL=C

ROOT=${ARILLA_ROOT:-/opt/arilla}
START_FREE_GB=${START_FREE_GB:-70}

for unit in arilla-feeds-daily arilla-catalog-pipeline arilla-backup-full arilla-backup-diff \
  arilla-backup-verify arilla-restore-test; do
  if systemctl is-active --quiet "$unit.service"; then
    echo "atlandi: $unit.service calisiyor" >&2
    exit 1
  fi
done

free_gb=$(df -BG --output=avail "$ROOT" | tail -1 | tr -dc 0-9)
if [ "${free_gb:-0}" -lt "$START_FREE_GB" ]; then
  echo "atlandi: bos disk ${free_gb:-?} GB < ${START_FREE_GB} GB" >&2
  exit 1
fi
exit 0
