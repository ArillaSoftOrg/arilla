{
  "name": "arilla",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @arilla/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "db:migrate": "pnpm --filter @arilla/db db:migrate",
    "db:bootstrap-role": "pnpm --filter @arilla/db db:bootstrap-role",
    "db:partitions": "pnpm --filter @arilla/db db:partitions",
    "db:verify": "pnpm --filter @arilla/db db:verify",
    "db:orphans": "pnpm --filter @arilla/db db:orphans",
    "seed": "pnpm --filter @arilla/db seed",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
